# Database (PostgreSQL + pgvector via Docker)
DATABASE_URL="postgresql://mindflow:mindflow@localhost:5432/mindflow"

# Models: configure chat and embedding separately in the top-bar settings dialog.
# Credentials are stored in the current browser and sent with each model request.
# The server does not use environment variables as fallback model credentials.

# File uploads
UPLOAD_DIR=./uploads
MAX_PDF_SIZE_MB=50
