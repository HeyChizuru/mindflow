# Database: PostgreSQL with pgvector installed; create a database before migrations.
# Example credentials only. Replace the password for your own environment.
DATABASE_URL="postgresql://mindflow:change-me@localhost:5432/mindflow"

# Models: configure chat and embedding separately in the top-bar settings dialog.
# Credentials are stored in the current browser and sent with each model request.
# The server does not use environment variables as fallback model credentials.

# File uploads
UPLOAD_DIR=./uploads
# PDF size limit is fixed in code at 50 MiB; there is no size-limit env override.
