// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// 课堂根实体（对齐 OpenMAIC Stage）
/// 存储课程需求、已确认大纲、生成状态与播放指针
model Stage {
  /// 主键 UUID
  id String @id @default(uuid()) @db.Uuid

  /// 课程标题（LLM 摘要或用户输入）
  name String

  /// 课程描述（可选）
  description String?

  /// 用户原始需求/提示词（必填，去空白后至少 10 字）
  requirement String @default("")

  /// 学习者昵称（可选；未填为 null，不写入学习者画像）
  userNickname String? @map("user_nickname")

  /// 学习者背景（可选；未填为 null，不写入学习者画像）
  userBio String? @map("user_bio")

  /// 授课语言指令（用户确认大纲时写入）
  languageDirective String? @map("language_directive")

  /// 是否有 RAG 知识库（PDF ingest 完成后置 true）
  hasKnowledgeBase Boolean @default(false) @map("has_knowledge_base")

  /// 课程整体生成状态
  /// 取值：draft | ingesting | outline_generating | outline_ready
  /// | plan_frozen | outline_reviewing | outline_confirmed | scene_generating
  /// | ready | outline_generation_failed | error
  status String @default("draft")

  /// 生成预览页当前阶段
  /// 取值：preparing | outline-ready | review | generating-content
  previewPhase String @default("preparing") @map("preview_phase")

  /// 用户确认时写入的 SceneOutline[]，确认前保持空数组
  outlines Json @default("[]")

  /// 执行稿大纲生命周期状态（与 status 不同，仅跟踪 outlines JSONB）
  /// 取值：draft → confirmed → scenes_ready → archived（可选）
  /// - draft：尚未确认，大纲仅存在页面
  /// - confirmed：用户确认大纲，开始生成 scenes
  /// - scenes_ready：全部 scene 生成完成，播放不读 outlines
  /// - archived：可选归档，不再需要单页重试
  outlinesStatus String @default("draft") @map("outlines_status")

  /// Phase 2 Plan 蓝图 SceneOutline[]（MVP/M2 保持 null）
  sceneOutlines Json? @map("scene_outlines")

  /// Plan 冻结时间（Phase 2 确认 Plan 后写入）
  outlineConfirmedAt DateTime? @map("outline_confirmed_at")

  /// 重新规划递增序号（每次「重新规划」+1）
  generationSessionId Int @default(1) @map("generation_session_id")

  /// Phase 2 Critic 评审失败报告（revisionCount 超限时展示）
  lastCriticReport Json? @map("last_critic_report")

  /// 最近成功保存的播放场景；读取／保存时校验课堂归属与就绪情况，不作为生成进度
  currentSceneId String? @map("current_scene_id") @db.Uuid

  /// M3 讨论 Agent ID 列表（默认来自 config/agents.json）
  agentIds Json? @map("agent_ids")

  /// 创建时间
  createdAt DateTime @default(now()) @map("created_at")

  /// 更新时间
  updatedAt DateTime @updatedAt @map("updated_at")

  /// 课堂下的 PDF 文档（上传即插入，ingest 前无全文）
  documents Document[]

  /// 课堂下的 RAG 分块（仅 ingest 后写入，按 stage_id 隔离检索）
  chunks Chunk[]

  scenes Scene[]

  quizSubmissions QuizSubmission[]

  chatTurns ChatTurn[]

  chatSessions ChatSession[]

  @@map("stage")
}

model Scene {
  id        String   @id @default(uuid()) @db.Uuid
  stageId   String   @map("stage_id") @db.Uuid
  outlineId String   @map("outline_id")
  type      String
  title     String
  order     Int
  content   Json
  actions   Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  stage Stage @relation(fields: [stageId], references: [id], onDelete: Cascade)

  quizSubmissions QuizSubmission[]

  chatTurns ChatTurn[]

  @@unique([id, stageId])
  @@unique([stageId, outlineId])
  @@index([stageId, order])
  @@map("scenes")
}

/// 每场景每题只保存当前提交；判分结果与批改执行身份均归属于该提交
model QuizSubmission {
  stageId      String @map("stage_id") @db.Uuid
  sceneId      String @map("scene_id") @db.Uuid
  questionId   String @map("question_id")
  submissionId String @map("submission_id") @db.Uuid
  /// 仅在成功替换答案时递增；批改状态更新不替换答案版本
  version Int @default(1)
  answer Json
  /// pending | processing | failed | completed；额外状态约束见对应迁移
  status      String
  result      Json?
  failureCode String? @map("failure_code")

  gradingRequestId String?   @map("grading_request_id") @db.Uuid
  executionId      String?   @map("execution_id") @db.Uuid
  gradingStartedAt DateTime? @map("grading_started_at") @db.Timestamptz(3)
  gradingExpiresAt DateTime? @map("grading_expires_at") @db.Timestamptz(3)
  gradedAt         DateTime? @map("graded_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  stage Stage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  scene Scene @relation(fields: [sceneId, stageId], references: [id, stageId], onDelete: Cascade)

  @@id([sceneId, questionId])
  @@index([stageId])
  @@map("quiz_submissions")
}

model ChatSession {
  id String @id @default(uuid()) @db.Uuid
  stageId String @map("stage_id") @db.Uuid
  isHistory Boolean @default(false) @map("is_history")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt DateTime @default(now()) @map("last_used_at") @db.Timestamptz(3)

  stage Stage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  turns ChatTurn[]

  @@unique([id, stageId])
  @@index([stageId, lastUsedAt, id])
  @@index([lastUsedAt, id])
  @@map("chat_sessions")
}

/// 一轮问题及至多一份完整回复；状态与执行一致性由增量迁移中的 CHECK 约束保证
model ChatTurn {
  id String @id @default(uuid()) @db.Uuid
  stageId String @map("stage_id") @db.Uuid
  sessionId String @map("session_id") @db.Uuid
  sceneId String @map("scene_id") @db.Uuid
  requestId String @map("request_id") @db.Uuid
  question String
  status String @default("pending")
  reply String?
  teacherId String? @map("teacher_id")
  sources Json?
  failureCode String? @map("failure_code")
  executionId String? @map("execution_id") @db.Uuid
  executionStartedAt DateTime? @map("execution_started_at") @db.Timestamptz(3)
  executionExpiresAt DateTime? @map("execution_expires_at") @db.Timestamptz(3)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  stage Stage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  scene Scene @relation(fields: [sceneId, stageId], references: [id, stageId], onDelete: Cascade)
  session ChatSession @relation(fields: [sessionId, stageId], references: [id, stageId], onDelete: Cascade)

  @@unique([sessionId, requestId])
  @@index([sessionId, createdAt, id])
  @@index([sceneId, stageId])
  @@map("chat_turns")
}

/// PDF 元数据（先存后解析：上传写 filename/storage_path，ingest 后补页数与全文）
model Document {
  /// 主键 UUID
  id String @id @default(uuid()) @db.Uuid

  /// 所属课堂
  stageId String @map("stage_id") @db.Uuid

  /// 原始文件名
  filename String

  /// PDF 页数（ingest 完成后写入；上传时为空）
  pageCount Int? @map("page_count")

  /// ingest 解析出的全文；上传时为空，大文本可只存 chunks
  rawText String? @map("raw_text")

  /// 本地 uploads/ 相对路径
  storagePath String @map("storage_path")

  /// 创建时间
  createdAt DateTime @default(now()) @map("created_at")

  /// 所属课堂
  stage Stage @relation(fields: [stageId], references: [id], onDelete: Cascade)

  /// 该文档切出的 RAG 分块
  chunks Chunk[]

  @@index([stageId])
  @@map("documents")
}

/// RAG 分块 + pgvector 向量（不单独建 chunk_embeddings 表）
model Chunk {
  /// 主键 UUID
  id String @id @default(uuid()) @db.Uuid

  /// 所属课堂（retrieve 必须按此过滤，防止跨课堂泄漏）
  stageId String @map("stage_id") @db.Uuid

  /// 来源文档
  documentId String @map("document_id") @db.Uuid

  /// 切块正文
  content String

  /// 对应 PDF 页码
  page Int?

  /// 全局切块序号（0..N）
  chunkIndex Int @map("chunk_index")

  /// 可选元数据，如 { filename }
  metadata Json?

  /// embedding 向量（ingest 后写入；维数 1024，对应 Qwen3-Embedding-0.6B）
  embedding Unsupported("vector")?

  /// 创建时间
  createdAt DateTime @default(now()) @map("created_at")

  /// 所属课堂
  stage Stage @relation(fields: [stageId], references: [id], onDelete: Cascade)

  /// 来源文档
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([stageId])
  @@index([documentId])
  @@map("chunks")
}
